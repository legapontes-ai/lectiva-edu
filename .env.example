# ==========================================================
# Lectiva Edu — exemplo de variáveis de ambiente
# Copie para .env.local e preencha. NÃO commite valores reais.
# ==========================================================

# ---- Supabase (público / browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx   # ou anon JWT (legacy)

# ---- Supabase (secreto / somente servidor) ----
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx            # NUNCA expor no client

# ---- Postgres (Prisma) ----
# Pooler (porta 6543, pgbouncer) — runtime do app:
DATABASE_URL=postgresql://postgres.<REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Conexão de sessão (porta 5432) — migrations do Prisma:
DIRECT_URL=postgresql://postgres.<REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres

# ---- E-mail transacional (Resend) ----
RESEND_API_KEY=re_xxx
EMAIL_FROM="Lectiva Edu <nao-responder@seu-dominio>"

# ---- Gateway de pagamento ----
PAYMENT_PROVIDER=mock            # mock | asaas | pagarme | stripe
PAYMENT_API_KEY=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_INACTIVITY_MINUTES=30
TZ=America/Sao_Paulo
